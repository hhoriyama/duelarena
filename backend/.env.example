# =============================================================
#  デュエルアリーナ Backend  .env サンプル
#  このファイルを backend\.env にコピーして値を埋める:
#    copy .env.example .env
# =============================================================

# -------------------------------------------------------------
# 【必須】① データベース（Supabase）  ← SETUP ステップ1
#   Supabase → Project Settings → Database → Connection string → URI
#   の「Session pooler（ポート5432）」をコピーし、
#   [YOUR-PASSWORD] を作成時に決めたDBパスワードに置き換える。
# -------------------------------------------------------------
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# -------------------------------------------------------------
# 【必須】② Bot との共有シークレット  ← SETUP ステップ4
#   自分で決めた長いランダム文字列。
#   duelarena-bot\.env の BOT_API_SECRET と「まったく同じ値」にする。
# -------------------------------------------------------------
BOT_API_SECRET=ここに共有シークレットを貼る

# -------------------------------------------------------------
# 【任意】③ 管理者のDiscordユーザーID（カンマ区切り）  ← SETUP ステップ3-7
#   紛争裁定などの管理操作を許可するユーザー。自分のIDを入れておく。
# -------------------------------------------------------------
ADMIN_DISCORD_IDS=あなたのDiscordユーザーID

# -------------------------------------------------------------
# 【任意】④ Web管理画面のログインパスワード
#   設定すると Web の /admin にこのパスワードでログインできる。
#   未設定なら管理ログインは無効（公開ページは影響なし）。
#   長め（16文字以上）のものを推奨。
# -------------------------------------------------------------
# ADMIN_PASSWORD=ここに管理者パスワード

# -------------------------------------------------------------
# 【任意】以下は未設定でも既定値で動く。通常は触らなくてよい。
# -------------------------------------------------------------
# PORT=3001                       # Backendの待受ポート
# MATCHMAKER_TICK_MS=15000        # マッチング評価の間隔(ms)
# MATCH_TIMEOUT_TICK_MS=30000     # 自動承認/引き分けチェックの間隔(ms)
# JWT_SECRET=dev-secret-change-me # 管理ログインのセッション署名に使用。
#                                 # ADMIN_PASSWORD を使うなら必ずランダム値に変更する。

# 注: 旧Web版の DISCORD_CLIENT_ID / SECRET / BOT_TOKEN / OAuth系や
#     SUPABASE_URL などは Bot構成では不要（DiscordはすべてBot側が担当）。
